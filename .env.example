# Google AI API Key (required for ADK / Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search (optional — enables Google search; falls back to DuckDuckGo)
GOOGLE_SEARCH_CX=your_custom_search_engine_id

# Model Configuration (optional)
GEMINI_MODEL=gemini-2.5-flash

# SerpAPI (optional — fast Google search fallback, no rate limits)
SERPAPI_API_KEY=your_serpapi_api_key

# Vertex AI (optional)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=

# Langfuse Observability (optional — tracing/metrics only)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Postgres Database (required for persistent session storage)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=everlearn
DATABASE_USER=everlearn
DATABASE_PASSWORD=change_me
